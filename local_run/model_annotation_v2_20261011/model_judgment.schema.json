{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Model-produced semantic judgment only",
  "required": [
    "category",
    "distinction_types",
    "reason"
  ],
  "properties": {
    "category": {
      "enum": [
        "exact_copy",
        "substantially_same_meaning",
        "overlapping_information",
        "merely_related",
        "unrelated",
        "uncertain"
      ]
    },
    "distinction_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "entity",
          "quantity",
          "negation",
          "time",
          "assertion",
          "constraints",
          "none",
          "uncertain"
        ]
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}

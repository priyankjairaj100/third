{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Harness record for model annotation; never a human response",
  "required": [
    "schema",
    "annotator_type",
    "human_completed",
    "pair_id",
    "call_id",
    "model_id",
    "model_revision",
    "weights_manifest_sha256",
    "prompt_sha256",
    "input_sha256",
    "runtime_manifest_sha256",
    "decoding_config_sha256",
    "orientation",
    "status",
    "judgment",
    "raw_output_sha256",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "third-model-response-v2"
    },
    "annotator_type": {
      "const": "model"
    },
    "human_completed": {
      "const": false
    },
    "pair_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "model_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "weights_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decoding_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "orientation": {
      "enum": [
        "canonical",
        "swapped_diagnostic"
      ]
    },
    "status": {
      "enum": [
        "valid",
        "invalid_json",
        "refusal",
        "context_overflow",
        "runtime_error"
      ]
    },
    "judgment": {
      "oneOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "additionalProperties": false,
          "title": "Model-produced semantic judgment only",
          "required": [
            "category",
            "distinction_types",
            "reason"
          ],
          "properties": {
            "category": {
              "enum": [
                "exact_copy",
                "substantially_same_meaning",
                "overlapping_information",
                "merely_related",
                "unrelated",
                "uncertain"
              ]
            },
            "distinction_types": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "entity",
                  "quantity",
                  "negation",
                  "time",
                  "assertion",
                  "constraints",
                  "none",
                  "uncertain"
                ]
              }
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_output_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "valid"
          }
        }
      },
      "then": {
        "properties": {
          "judgment": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "title": "Model-produced semantic judgment only",
            "required": [
              "category",
              "distinction_types",
              "reason"
            ],
            "properties": {
              "category": {
                "enum": [
                  "exact_copy",
                  "substantially_same_meaning",
                  "overlapping_information",
                  "merely_related",
                  "unrelated",
                  "uncertain"
                ]
              },
              "distinction_types": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "entity",
                    "quantity",
                    "negation",
                    "time",
                    "assertion",
                    "constraints",
                    "none",
                    "uncertain"
                  ]
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              }
            }
          },
          "raw_output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "judgment": {
            "type": "null"
          }
        }
      }
    }
  ]
}
